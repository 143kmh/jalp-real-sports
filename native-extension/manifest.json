{
  "manifest_version": 3,
  "name": "Real Manager — Chrome",
  "short_name": "Real Manager",
  "version": "0.4.6",
  "description": "Управление штатным интерфейсом Real в отдельном обычном Chrome. Без CDP, обхода проверок и изменения цен.",
  "permissions": ["storage", "alarms", "webRequest"],
  "host_permissions": ["http://127.0.0.1:5127/*", "https://realsports.io/*", "https://www.realsports.io/*", "https://web.realapp.com/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {"matches": ["http://127.0.0.1:5127/*"], "js": ["panel.js"], "run_at": "document_idle"},
    {"matches": ["https://realsports.io/*", "https://www.realsports.io/*"], "js": ["navigation.js", "pack-listing.js", "workflow.js", "real.js"], "run_at": "document_idle"}
  ]
}
